{
  "name": "quant-trading-client",
  "version": "1.0.0",
  "description": "量化交易统一客户端 — 在一个窗口内切换币安量化、HTF 型态终端、AI 决策端，并管理本地服务",
  "main": "main.js",
  "author": {
    "name": "Quant Trading",
    "email": "noreply@example.com"
  },
  "license": "MIT",
  "private": false,
  "scripts": {
    "start": "electron .",
    "icon": "python tools/make_icon.py",
    "dist": "electron-builder --win",
    "dist:local": "electron-builder --win -c.win.signAndEditExecutable=false",
    "dist:portable": "electron-builder --win portable",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.quant.trading.client",
    "productName": "QuantTradingClient",
    "artifactName": "QuantTradingClient-${version}-${arch}.${ext}",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "build/icon.png",
      "build/tray.png"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "量化交易客户端",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "QuantTradingClient-${version}-portable.${ext}"
    }
  }
}
